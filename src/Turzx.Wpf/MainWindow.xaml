<ui:FluentWindow x:Class="Turzx.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TURZX 屏幕控制"
                 Icon="Assets/LOGO3.ico"
                 Width="1440" Height="900"
                 MinWidth="1440" MaxWidth="1440"
                 MinHeight="900" MaxHeight="900"
                 SizeToContent="Manual"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 Loaded="Window_Loaded"
                 PreviewMouseDown="MainWindow_PreviewMouseDown"
                 Closing="Window_Closing">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.Resources>
            <Style TargetType="ScrollBar"><Setter Property="Visibility" Value="Collapsed"/></Style>
            <Style TargetType="{x:Type ui:Card}" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="DraggableNumberTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="ToolTip" Value="可直接输入，也可按住鼠标左右拖动"/>
                <EventSetter Event="LostFocus" Handler="PropertyEditor_LostFocus"/>
                <EventSetter Event="PreviewKeyDown" Handler="PropertyEditor_PreviewKeyDown"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NumericInput_MouseLeftButtonDown"/>
                <EventSetter Event="PreviewMouseMove" Handler="NumericInput_MouseMove"/>
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="NumericInput_MouseLeftButtonUp"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Title="TURZX 屏幕控制" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <ui:Button x:Name="NavDashboard" Content="系统信息" Width="160" Height="43" Margin="0,0,0,7" HorizontalAlignment="Center" Appearance="Primary" Click="Navigate_Click" Tag="Dashboard"/>
                        <ui:Button x:Name="NavImage" Content="图片显示" Width="160" Height="43" Margin="0,0,0,7" HorizontalAlignment="Center" Click="Navigate_Click" Tag="Image"/>
                        <ui:Button x:Name="NavVideo" Content="视频播放" Width="160" Height="43" Margin="0,0,0,7" HorizontalAlignment="Center" Click="Navigate_Click" Tag="Video"/>
                        <ui:Button x:Name="NavCreative" Content="创意" Width="160" Height="43" Margin="0,0,0,7" HorizontalAlignment="Center" Click="Navigate_Click" Tag="Creative"/>
                        <ui:Button x:Name="NavEditor" Content="监控主题编辑器" Width="160" Height="43" Margin="0,0,0,7" HorizontalAlignment="Center" Click="Navigate_Click" Tag="Editor"/>
                        <ui:Button x:Name="NavSensors" Content="常用传感器" Width="160" Height="43" Margin="0,0,0,7" HorizontalAlignment="Center" Click="Navigate_Click" Tag="Sensors"/>
                        <ui:Button x:Name="NavSettings" Content="设置" Width="160" Height="43" HorizontalAlignment="Center" Click="Navigate_Click" Tag="Settings"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,0,0,12" Padding="10" CornerRadius="12" Background="#0C000000">
                        <StackPanel><TextBlock x:Name="NavDeviceStatus" Text="正在检测设备" FontWeight="SemiBold"/><TextBlock Text="960 × 320 · USB" Margin="0,3,0,0" FontSize="11" Opacity="0.6"/></StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <Separator Margin="0,0,0,10"/>
                        <Image x:Name="SidebarLogoImage" Source="Assets/LOGO2.png" Width="150" Height="53" Stretch="Uniform" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <Grid Grid.Column="2">
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="12"/><RowDefinition Height="280"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ui:Card Padding="20"><Grid><TextBlock Text="系统信息" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ui:Button Content="检查连接" Width="112" Height="40" Click="CheckDevice_Click"/><ui:Button Content="打开主题编辑器" Width="148" Height="40" Margin="8,0,0,0" Appearance="Primary" Click="OpenEditor_Click"/></StackPanel></Grid></ui:Card>
                    <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <ui:Card x:Name="DashboardPreviewCard" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="屏幕预览" FontSize="15" FontWeight="SemiBold"/><Viewbox Grid.Row="1" Stretch="Uniform"><Border Width="960" Height="320" CornerRadius="18" Background="#07111F" ClipToBounds="True"><Image x:Name="DashboardPreviewImage" Stretch="Fill"/></Border></Viewbox></Grid></ui:Card>
                        <ui:Card x:Name="DashboardDeviceCard" Grid.Column="2" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid ClipToBounds="True">
                                <Image x:Name="DeviceLogoImage" Source="Assets/LOGO1.png" Width="154" Height="154" Stretch="Uniform" Opacity="0.13" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                                <StackPanel Panel.ZIndex="1">
                                    <TextBlock Text="设备与输出" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CpuHardwareName" Text="CPU · 等待识别" Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="GpuHardwareName" Text="GPU · 等待识别" Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="屏幕尺寸" Margin="0,14,0,0" Opacity="0.55"/>
                                    <TextBlock Text="960 × 320 · 3:1 横向" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="输出协议" Margin="0,12,0,0" Opacity="0.55"/>
                                    <TextBlock Text="USB WinUSB · PNG 帧" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </Grid>
                    <ui:Card x:Name="DashboardOverviewCard" Grid.Row="4" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="实时概览" FontSize="16" FontWeight="SemiBold"/><UniformGrid Grid.Row="1" Columns="4" Rows="4">
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="CPU 负载" Opacity="0.6"/><TextBlock x:Name="CpuValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="CPU 温度" Opacity="0.6"/><TextBlock x:Name="CpuTempValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="CPU 功耗" Opacity="0.6"/><TextBlock x:Name="CpuPowerValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="CPU 频率" Opacity="0.6"/><TextBlock x:Name="CpuClockValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="GPU 负载" Opacity="0.6"/><TextBlock x:Name="GpuValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="GPU 温度" Opacity="0.6"/><TextBlock x:Name="GpuTempValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="GPU 功耗" Opacity="0.6"/><TextBlock x:Name="GpuPowerValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="GPU 频率" Opacity="0.6"/><TextBlock x:Name="GpuClockValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="内存使用率" Opacity="0.6"/><TextBlock x:Name="MemoryValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="内存频率" Opacity="0.6"/><TextBlock x:Name="MemoryClockValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="C 盘使用率" Opacity="0.6"/><TextBlock x:Name="DiskCValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="硬盘总使用率" Opacity="0.6"/><TextBlock x:Name="DiskValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="网络下载" Opacity="0.6"/><TextBlock x:Name="DownloadValue" Text="--" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="网络上传" Opacity="0.6"/><TextBlock x:Name="UploadValue" Text="--" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="软件后台内存占用率" Opacity="0.6" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AppMemoryValue" Text="--" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="4" Padding="10" CornerRadius="13" Background="#0B7F8CFF"><StackPanel><TextBlock Text="系统运行时间" Opacity="0.6"/><TextBlock x:Name="UptimeValue" Text="--" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid></Grid></ui:Card>
                </Grid>

                <Grid x:Name="ImagePage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ui:Card Padding="20"><Grid><TextBlock Text="图片显示" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ui:Button Content="选择图片" Width="108" Height="40" Click="ChooseImage_Click"/><ui:Button Content="发送到屏幕" Width="128" Height="40" Margin="8,0,0,0" Appearance="Primary" Click="SendImage_Click"/></StackPanel></Grid></ui:Card>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                        <ui:Card Padding="18" Height="440" VerticalAlignment="Top"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="图片预览" FontWeight="SemiBold"/><Viewbox Grid.Row="1" Stretch="Uniform"><Border Width="960" Height="320" CornerRadius="18" Background="Black" ClipToBounds="True"><Grid x:Name="ImagePreviewSurface" Width="960" Height="320" Background="Black" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="ImagePreview_MouseLeftButtonDown" MouseMove="ImagePreview_MouseMove" MouseLeftButtonUp="ImagePreview_MouseLeftButtonUp" MouseWheel="ImagePreview_MouseWheel"><Viewbox x:Name="ImageContentHost" Width="960" Height="320" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Viewbox.RenderTransform><TransformGroup><ScaleTransform x:Name="ImagePreviewScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="ImagePreviewTranslate"/></TransformGroup></Viewbox.RenderTransform><Image x:Name="ImagePreview" Stretch="Fill"><Image.LayoutTransform><RotateTransform x:Name="ImagePreviewRotation" Angle="0"/></Image.LayoutTransform></Image></Viewbox></Grid></Border></Viewbox></Grid></ui:Card>
                        <ui:Card Grid.Column="2" Padding="20" Height="440" VerticalAlignment="Top"><StackPanel><TextBlock Text="图片设置" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="文件" Margin="0,18,0,6" Opacity="0.6"/><TextBlock x:Name="ImagePathText" Text="尚未选择" TextWrapping="Wrap"/><TextBlock Text="画面适配" Margin="0,16,0,6" Opacity="0.6"/><ComboBox x:Name="ImageFitCombo" SelectedIndex="1" SelectionChanged="ImageFitCombo_SelectionChanged"><ComboBoxItem Content="完整显示"/><ComboBoxItem Content="裁剪铺满"/><ComboBoxItem Content="拉伸"/><ComboBoxItem Content="自定义拖动缩放"/></ComboBox><TextBlock Text="旋转" Margin="0,16,0,6" Opacity="0.6"/><ComboBox x:Name="ImageRotationCombo" SelectedIndex="0" SelectionChanged="ImageRotationCombo_SelectionChanged"><ComboBoxItem Content="0°"/><ComboBoxItem Content="顺时针 90°"/><ComboBoxItem Content="180°"/><ComboBoxItem Content="顺时针 270°"/></ComboBox><TextBlock Text="自定义模式从完整图片开始，可直接拖动画面并用滚轮缩放。" Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.6"/><TextBlock x:Name="ImageStatusText" Margin="0,16,0,0" FontWeight="SemiBold"/></StackPanel></ui:Card>
                    </Grid>
                </Grid>

                <Grid x:Name="VideoPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ui:Card Padding="20"><Grid><TextBlock Text="视频播放" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ui:Button Content="选择视频" Width="108" Height="40" Click="ChooseVideo_Click"/><ui:Button Content="停止" Width="82" Height="40" Margin="8,0,0,0" Click="StopVideo_Click"/><ui:Button Content="播放到屏幕" Width="128" Height="40" Margin="8,0,0,0" Appearance="Primary" Click="PlayVideo_Click"/></StackPanel></Grid></ui:Card>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                        <ui:Card Padding="18" Height="500" VerticalAlignment="Top"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="视频预览" FontWeight="SemiBold"/><Viewbox Grid.Row="1" Stretch="Uniform"><Border Width="960" Height="320" CornerRadius="18" Background="Black" ClipToBounds="True"><Grid x:Name="VideoPreviewSurface" Width="960" Height="320" Background="Black" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="VideoPreview_MouseLeftButtonDown" MouseMove="VideoPreview_MouseMove" MouseLeftButtonUp="VideoPreview_MouseLeftButtonUp" MouseWheel="VideoPreview_MouseWheel"><Viewbox x:Name="VideoContentHost" Width="960" Height="320" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"><Viewbox.RenderTransform><TransformGroup><ScaleTransform x:Name="VideoPreviewScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="VideoPreviewTranslate"/></TransformGroup></Viewbox.RenderTransform><MediaElement x:Name="VideoPreview" Width="960" Height="320" Stretch="Fill" LoadedBehavior="Manual" UnloadedBehavior="Stop" IsMuted="True" MediaEnded="VideoPreview_MediaEnded"><MediaElement.LayoutTransform><RotateTransform x:Name="VideoPreviewRotation" Angle="0"/></MediaElement.LayoutTransform></MediaElement></Viewbox></Grid></Border></Viewbox></Grid></ui:Card>
                        <ui:Card Grid.Column="2" Padding="20" Height="500" VerticalAlignment="Top"><StackPanel><TextBlock Text="播放设置" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="文件" Margin="0,14,0,4" Opacity="0.6"/><TextBlock x:Name="VideoPathText" Text="尚未选择" TextWrapping="Wrap"/><TextBlock Text="画面适配" Margin="0,12,0,4" Opacity="0.6"/><ComboBox x:Name="VideoFitCombo" SelectedIndex="0" SelectionChanged="VideoFitCombo_SelectionChanged"><ComboBoxItem Content="裁剪铺满"/><ComboBoxItem Content="完整显示"/><ComboBoxItem Content="拉伸"/><ComboBoxItem Content="自定义拖动缩放"/></ComboBox><TextBlock Text="旋转" Margin="0,12,0,4" Opacity="0.6"/><ComboBox x:Name="VideoRotationCombo" SelectedIndex="0" SelectionChanged="VideoRotationCombo_SelectionChanged"><ComboBoxItem Content="0°"/><ComboBoxItem Content="顺时针 90°"/><ComboBoxItem Content="180°"/><ComboBoxItem Content="顺时针 270°"/></ComboBox><TextBlock Text="播放帧率" Margin="0,12,0,4" Opacity="0.6"/><ComboBox x:Name="VideoFpsCombo" SelectedIndex="3"><ComboBoxItem Content="5 FPS"/><ComboBoxItem Content="10 FPS"/><ComboBoxItem Content="12 FPS"/><ComboBoxItem Content="15 FPS"/><ComboBoxItem Content="20 FPS（实验）"/><ComboBoxItem Content="24 FPS（实验）"/></ComboBox><CheckBox x:Name="VideoLoopCheck" Content="循环播放" IsChecked="True" Margin="0,12,0,0"/><TextBlock Text="自定义模式从完整视频开始，拖动和滚轮缩放会同步用于USB输出。" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.6"/><TextBlock x:Name="VideoStatusText" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></ui:Card>
                    </Grid>
                </Grid>

                <Grid x:Name="CreativePage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="12"/><RowDefinition Height="350"/><RowDefinition Height="12"/><RowDefinition Height="58"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ui:Card Padding="20"><TextBlock Text="创意" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></ui:Card>
                    <ui:Card Grid.Row="2" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions><Grid><TextBlock Text="图片输出预览" FontWeight="SemiBold"/><TextBlock x:Name="CreativePreviewStateText" Text="等待生成" HorizontalAlignment="Right" Opacity="0.6"/></Grid><Border Grid.Row="1" Background="#1E000000" CornerRadius="16" Padding="10"><Viewbox Stretch="Uniform"><Border Width="960" Height="320" Background="#08111F" CornerRadius="18" ClipToBounds="True"><Grid x:Name="CreativePreviewSurface" Width="960" Height="320" Background="#08111F"><Image x:Name="CreativePreviewImage" Stretch="UniformToFill"/></Grid></Border></Viewbox></Border><TextBlock Grid.Row="2" Text="960 × 320 · 3:1 屏幕背景" VerticalAlignment="Bottom" FontSize="11" Opacity="0.55"/></Grid></ui:Card>
                    <ui:Card Grid.Row="4" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="180"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="8"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><TextBlock Text="工具栏" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="CreativeStyleCombo" Grid.Column="2" Height="36" SelectedIndex="0"><ComboBoxItem Content="无风格" Tag=""/><ComboBoxItem Content="黑白极简" Tag="黑白极简、克制留白"/><ComboBoxItem Content="未来科技" Tag="未来科技、精密光效"/><ComboBoxItem Content="自然氛围" Tag="自然氛围、柔和光影"/><ComboBoxItem Content="抽象艺术" Tag="抽象艺术、流动构图"/></ComboBox><TextBlock Grid.Column="4" Text="质量" VerticalAlignment="Center"/><ComboBox x:Name="CreativeQualityCombo" Grid.Column="6" Height="36" SelectedIndex="0"><ComboBoxItem Content="标准" Tag="standard"/><ComboBoxItem Content="高质量" Tag="high"/></ComboBox><ui:Button Grid.Column="8" Content="加载提示词" Height="36" Click="CreativeLoadPrompt_Click"/><ui:Button x:Name="CreativeSaveButton" Grid.Column="10" Content="保存图片" Height="36" IsEnabled="False" Click="CreativeSaveImage_Click"/></Grid></ui:Card>
                    <ui:Card Grid.Row="6" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock Text="提示词" FontSize="16" FontWeight="SemiBold"/><TextBox x:Name="CreativePromptText" Grid.Row="1" Margin="0,6,0,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" VerticalContentAlignment="Top" Padding="12" SpellCheck.IsEnabled="True"/><Grid Grid.Row="2"><TextBlock x:Name="CreativeStatusText" Text="在设置中配置图像生成 API 后即可开始创作" VerticalAlignment="Center" Opacity="0.65"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="清空" Width="84" Height="40" Click="CreativeClear_Click"/><ui:Button x:Name="CreativeGenerateButton" Content="生成背景" Width="124" Height="40" Margin="8,0,0,0" Appearance="Primary" Click="CreativeGenerate_Click"/></StackPanel></Grid></Grid></ui:Card>
                </Grid>

                <Grid x:Name="EditorPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ui:Card Padding="20"><Grid><TextBlock Text="系统监控主题编辑器" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ui:Button Content="照片背景" Width="92" Height="40" Click="PhotoBackground_Click"/><ui:Button Content="视频背景" Width="92" Height="40" Margin="8,0,0,0" Click="VideoBackground_Click"/><ui:Button Content="清除背景" Width="84" Height="40" Margin="8,0,0,0" Click="ClearBackground_Click"/><ui:Button Content="打开" Width="64" Height="40" Margin="12,0,0,0" Click="OpenTheme_Click"/><ui:Button Content="保存" Width="64" Height="40" Margin="8,0,0,0" Click="SaveTheme_Click"/><ui:Button x:Name="StartThemeButton" Content="开始实时显示" Width="118" Height="40" Margin="12,0,0,0" Appearance="Primary" Click="StartTheme_Click"/><ui:Button x:Name="StopThemeButton" Content="停止" Width="70" Height="40" Margin="8,0,0,0" IsEnabled="False" Click="StopTheme_Click"/></StackPanel></Grid></ui:Card>
                    <Grid Grid.Row="2" x:Name="EditorContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="330"/><RowDefinition Height="12"/><RowDefinition Height="58"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="274"/></Grid.ColumnDefinitions>
