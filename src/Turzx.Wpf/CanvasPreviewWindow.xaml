<Window x:Class="Turzx.Desktop.CanvasPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="屏幕画布预览" Width="1500" Height="630"
        MinWidth="1036" MinHeight="470"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:Card Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="82"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="屏幕画布预览" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="可直接拖动组件；主窗口属性与画布保持实时同步" Margin="0,3,0,0" FontSize="11" Opacity="0.58"/></StackPanel>
                <ComboBox x:Name="PreviewSizeCombo" Grid.Column="1" Height="36" SelectedIndex="2" SelectionChanged="PreviewSizeCombo_SelectionChanged">
                    <ComboBoxItem Content="960 × 320（100%）" Tag="1"/>
                    <ComboBoxItem Content="1200 × 400（125%）" Tag="1.25"/>
                    <ComboBoxItem Content="1440 × 480（150%）" Tag="1.5"/>
                    <ComboBoxItem Content="1680 × 560（175%）" Tag="1.75"/>
                </ComboBox>
                <ui:Button Grid.Column="3" Content="关闭" Height="36" Click="Close_Click"/>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="2" Padding="16">
            <Viewbox Stretch="Uniform">
                <Border x:Name="PreviewFrame" Width="1440" Height="480"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#08111F" CornerRadius="18" ClipToBounds="True">
                    <Viewbox Stretch="Fill">
                        <Grid Width="960" Height="320">
                            <Rectangle x:Name="PreviewSurface" Stretch="Fill"/>
                            <Canvas x:Name="InteractionCanvas" Width="960" Height="320" Background="#01000000"/>
                        </Grid>
                    </Viewbox>
                </Border>
            </Viewbox>
        </ui:Card>
    </Grid>
</Window>
