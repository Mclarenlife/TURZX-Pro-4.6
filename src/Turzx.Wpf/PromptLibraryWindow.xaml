<Window x:Class="Turzx.Desktop.PromptLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="加载提示词" Width="1080" Height="680"
        MinWidth="1080" MaxWidth="1080" MinHeight="680" MaxHeight="680"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:Card Padding="16"><TextBlock Text="提示词预设" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></ui:Card>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ui:Card Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="22"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="选择提示词" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="提示词种类" FontSize="11" Opacity="0.58"/><ComboBox x:Name="CategoryCombo" Grid.Row="2" Height="36" SelectionChanged="CategoryCombo_SelectionChanged"><ComboBoxItem Content="多功能主题" Tag="多功能主题"/><ComboBoxItem Content="游戏主题" Tag="游戏主题"/><ComboBoxItem Content="动漫主题" Tag="动漫主题"/><ComboBoxItem Content="极简主题" Tag="极简主题"/><ComboBoxItem Content="科幻主题" Tag="科幻主题"/></ComboBox><ListBox x:Name="PresetList" Grid.Row="3" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionChanged="PresetList_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Padding="12" CornerRadius="10" Background="#0D7F8CFF"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Opacity="0.58"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></ui:Card>
            <ui:Card Grid.Column="2" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions><TextBlock x:Name="PresetTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="提示词会加载到创意页面，也可以在下方先行修改。" FontSize="11" Opacity="0.58"/><TextBox x:Name="PromptEditor" Grid.Row="2" Margin="0,8,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" VerticalContentAlignment="Top" Padding="12"/><Grid Grid.Row="3"><TextBlock Text="所有预设均禁止生成文字、数据与进度条。" VerticalAlignment="Center" FontSize="11" Opacity="0.58"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="取消" Width="88" Height="40" Click="Cancel_Click"/><ui:Button Content="加载提示词" Width="124" Height="40" Margin="8,0,0,0" Appearance="Primary" Click="LoadPrompt_Click"/></StackPanel></Grid></Grid></ui:Card>
        </Grid>
    </Grid>
</Window>
